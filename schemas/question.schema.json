{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mymanabi/question.schema.json",
  "title": "MyManabi question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "unitId",
    "skillIds",
    "questionType",
    "title",
    "note",
    "answer",
    "source",
    "reviewStatus",
    "purposes"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "unitId": { "type": "string", "minLength": 1 },
    "skillIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "questionType": {
      "enum": ["numeric", "kanji", "multiple-choice", "word-problem", "free-text", "handwriting", "speech"]
    },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "source-region", "source-page", "image", "audio"] },
        "text": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "#/$defs/region" },
        "imagePath": { "type": "string", "minLength": 1 },
        "mediaId": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string" },
        "showTranscript": { "type": "boolean" }
      }
    },
    "expectedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "numeric", "choice", "handwriting", "speech", "drawing", "parent-review"] },
        "rubric": { "type": "string" }
      }
    },
    "note": { "type": "string" },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "exact-text",
            "numeric",
            "choice",
            "ai-assisted",
            "source-region",
            "image",
            "exemplar-image",
            "audio",
            "exemplar-audio",
            "manual-review"
          ]
        },
        "value": { "type": "string", "minLength": 1 },
        "textValue": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "region": { "$ref": "#/$defs/region" },
        "imagePath": { "type": "string", "minLength": 1 },
        "mediaId": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string" },
        "rubric": { "type": "string" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation"],
      "properties": {
        "questionRegionId": { "type": "string", "minLength": 1 },
        "answerRegionId": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["same-item", "same-page", "manual-pair", "answer-key"] },
        "itemLabel": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["adult-confirmed", "heuristic", "ai-suggested"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["adult-authored", "ai-generated", "local-generated", "imported"] },
        "templateId": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "itemLabel": { "type": "string", "minLength": 1 }
      }
    },
    "reviewStatus": {
      "enum": ["draft", "adult-approved", "auto-approved", "suspended"]
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["learning", "review", "assessment"] }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equivalenceGroupId", "relation"],
      "properties": {
        "equivalenceGroupId": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["same-question", "isomorphic", "applied"] }
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
