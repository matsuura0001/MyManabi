{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mymanabi/extraction-result.schema.json",
  "title": "MyManabi extraction result",
  "description": "Output of the local source extraction worker (tools/ocr-worker). An intermediate review artifact, not a final Question. Stored under <DATA_DIR>/content/extractions/<id>/extraction-result.json and never committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceDocumentId",
    "engine",
    "engineVersion",
    "language",
    "dpi",
    "generatedAtEpochSeconds",
    "pageCount",
    "pages",
    "candidates",
    "metrics"
  ],
  "properties": {
    "sourceDocumentId": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string" },
    "language": { "type": "string", "minLength": 1 },
    "dpi": { "type": "integer", "minimum": 1 },
    "generatedAtEpochSeconds": { "type": "integer", "minimum": 0 },
    "pageCount": { "type": "integer", "minimum": 0 },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "width", "height", "imagePath", "ocrText", "meanConfidence"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "imagePath": { "type": "string", "pattern": "^content/extractions/[A-Za-z0-9_-]+/.+\\.png$" },
        "ocrText": { "type": "string" },
        "meanConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "page", "region", "ocrText", "confidence", "suggestedQuestionType", "reviewStatus"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "itemLabel": { "type": "string", "minLength": 1 },
        "region": { "$ref": "#/$defs/region" },
        "regionImagePath": { "type": "string", "pattern": "^content/extractions/[A-Za-z0-9_-]+/.+\\.png$" },
        "ocrText": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "suggestedQuestionType": {
          "enum": ["numeric", "kanji", "multiple-choice", "word-problem", "free-text", "handwriting", "speech", "unknown"]
        },
        "reviewStatus": { "enum": ["draft", "adult-approved", "suspended"] }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "description": "Region as ratios of the page (0..1), resolution-independent.",
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractionRoute",
        "localOcrEngine",
        "pages",
        "candidateQuestions",
        "aiAssistedRegions",
        "adultCorrections",
        "elapsedMs",
        "estimatedApiCostUsd"
      ],
      "properties": {
        "extractionRoute": { "type": "string", "minLength": 1 },
        "localOcrEngine": { "type": "string", "minLength": 1 },
        "pages": { "type": "integer", "minimum": 0 },
        "candidateQuestions": { "type": "integer", "minimum": 0 },
        "aiAssistedRegions": { "type": "integer", "minimum": 0 },
        "adultCorrections": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "estimatedApiCostUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
